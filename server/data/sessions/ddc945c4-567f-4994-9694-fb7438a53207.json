    "2": {
      "app_name": "StayRide",
      "description": "A unified travel platform combining accommodation and ride booking. Hosts manage properties and drivers manage vehicles, with dynamic pricing, real-time tracking, and an integrated wallet system.",
      "architecture_pattern": "microservices",
      "modules": [
        {
          "name": "AuthModule",
          "layer": "infrastructure",
          "responsibility": "Handles user registration, authentication, and session management",
          "exposes": [
            "register",
            "login",
            "logout",
            "refreshToken",
            "verifyIdentity"
          ],
          "depends_on": []
        },
        {
          "name": "UserModule",
          "layer": "business",
          "responsibility": "Manages user profiles, roles, and preferences",
          "exposes": [
            "getProfile",
            "updateProfile",
            "getUser",
            "listUsers"
          ],
          "depends_on": [
            "AuthModule"
          ]
        },
        {
          "name": "PropertyModule",
          "layer": "business",
          "responsibility": "Manages property listings, availability, and host operations",
          "exposes": [
            "createProperty",
            "updateProperty",
            "listProperties",
            "searchProperties",
            "setAvailability"
          ],
          "depends_on": [
            "UserModule",
            "PricingModule"
          ]
        },
        {
          "name": "VehicleModule",
          "layer": "business",
          "responsibility": "Manages vehicle listings and driver availability",
          "exposes": [
            "createVehicle",
            "updateVehicle",
            "listVehicles",
            "updateAvailability"
          ],
          "depends_on": [
            "UserModule"
          ]
        },
        {
          "name": "BookingModule",
          "layer": "business",
          "responsibility": "Handles accommodation and ride booking lifecycle",
          "exposes": [
            "createBooking",
            "cancelBooking",
            "getBooking",
            "listBookings",
            "confirmBooking"
          ],
          "depends_on": [
            "UserModule",
            "PropertyModule",
            "VehicleModule",
            "PricingModule",
            "PaymentModule"
          ]
        },
        {
          "name": "RideModule",
          "layer": "business",
          "responsibility": "Manages ride-specific operations including real-time tracking",
          "exposes": [
            "requestRide",
            "acceptRide",
            "updateLocation",
            "completeRide",
            "trackRide"
          ],
          "depends_on": [
            "VehicleModule",
            "LocationModule"
          ]
        },
        {
          "name": "PaymentModule",
          "layer": "business",
          "responsibility": "Handles payments, refunds, and wallet operations",
          "exposes": [
            "processPayment",
            "refundPayment",
            "getWallet",
            "addFunds",
            "withdrawFunds"
          ],
          "depends_on": [
            "UserModule"
          ]
        },
        {
          "name": "PricingModule",
          "layer": "business",
          "responsibility": "Calculates dynamic pricing based on demand, time, and rules",
          "exposes": [
            "calculatePrice",
            "getPricingRules",
            "setPricingRule",
            "applySurge"
          ],
          "depends_on": []
        },
        {
          "name": "LocationModule",
