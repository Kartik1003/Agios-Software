      "user_flows": [
        {
          "name": "User Registration",
          "actors": [
            "user"
          ],
          "trigger": "User submits registration form",
          "steps": [
            "User fills registration form with email, password, and profile details",
            "System validates email uniqueness and password strength",
            "System creates User record with hashed password",
            "System creates associated Profile and Wallet records",
            "System sends verification email to user",
            "User receives account confirmation"
          ],
          "outcome": "New user account created with active profile and initialized wallet"
        },
        {
          "name": "Search and Book Accommodations",
          "actors": [
            "user"
          ],
          "trigger": "User searches for available properties",
          "steps": [
            "User enters location, dates, and guest count",
            "System queries StayProperty for matching available properties",
            "System applies DynamicPricingRule to calculate prices",
            "System displays property list with pricing and availability",
            "User selects property and confirms booking",
            "System creates Payment record and processes transaction",
            "System updates StayProperty availability",
            "System sends booking confirmation notification"
          ],
          "outcome": "Accommodation booked with payment processed and confirmation sent"
        },
        {
          "name": "Search and Book Rides",
          "actors": [
            "user"
          ],
          "trigger": "User requests a ride",
          "steps": [
            "User enters pickup location and destination",
            "System creates RideRequest record",
            "System searches for available Vehicle with nearby drivers",
            "System matches user with nearest available driver",
            "System creates Ride record and assigns driver",
            "System sends driver assignment notification to user",
            "Driver receives ride request notification",
            "Driver accepts ride and begins navigation"
          ],
          "outcome": "Ride request created and driver assigned with real-time tracking enabled"
        },
        {
          "name": "Host Property Management",
          "actors": [
            "user"
          ],
          "trigger": "Host accesses property dashboard",
          "steps": [
            "Host logs in and navigates to property management section",
            "System displays list of StayProperty records owned by host",
            "Host creates new property listing or edits existing one",
            "Host sets pricing and availability schedule",
            "Host configures DynamicPricingRule for demand-based pricing",
            "System saves property and pricing rule updates",
            "System sends confirmation of changes"
          ],
          "outcome": "Property listing updated with new pricing and availability rules"
        },
        {
          "name": "Driver Vehicle Management",
          "actors": [
            "user"
          ],
          "trigger": "Driver accesses vehicle dashboard",
          "steps": [
            "Driver logs in and navigates to vehicle management section",
            "System displays Vehicle records owned by driver",
            "Driver adds new vehicle or updates existing vehicle details",
            "Driver sets vehicle availability status",
            "System saves vehicle information",
            "System updates driver's availability for ride matching"
          ],
          "outcome": "Vehicle information updated and driver availability synchronized"
